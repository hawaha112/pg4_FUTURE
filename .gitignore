# macOS
.DS_Store
.fuse_hidden*
~$*

# Claude Code 本地配置（含本机路径，不适合跨机同步）
.claude/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 数据库文件（运行时数据）
*.db

# 日志
*.log

