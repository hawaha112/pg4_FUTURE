# 运行时/备份文件
ai-morning-news/*.db.*
ai-morning-news/daily_run.log.*
ai-morning-news/*.pid

# TG"单条更新"状态（云端经 briefing-state 分支持久化，不入 main）
ai-morning-news/tg_state.json

# Node.js（代理项目）
node_modules/
ai-morning-news/claude-max-api-proxy/

# 环境变量
.env
twitter_cookies.json

# briefing_renderer 生成产物（每日滚动，不入版本控制；事实来源在 ai-morning-news/templates/）
/index.html
/modal_data.js
/briefing_preview.html
/test_preview.html
